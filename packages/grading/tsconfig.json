{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Consumed as TypeScript source by Metro and by Next.js, so resolution
    // follows the bundler algorithm rather than Node's, and nothing is emitted.
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    // `src` is pure logic and touches no file. The layering test reads this
    // package's own sources to prove it, which is the one reason for node here.
    "types": ["node"]
  },
  // Every file must belong to a tsconfig or the ESLint project service refuses
  // to lint it, so tests are included rather than excluded.
  "include": ["src", "test", "vitest.config.ts"]
}
