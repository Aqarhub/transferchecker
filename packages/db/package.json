{
  "name": "@transferchecker/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./local": "./src/local.ts",
    "./connect": "./src/connect.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "verify": "tsx src/verify.ts"
  },
  "dependencies": {
    "@transferchecker/account": "workspace:*",
    "@transferchecker/grading": "workspace:*",
    "drizzle-orm": "catalog:",
    "zod": "catalog:",
    "postgres": "catalog:",
    "@node-rs/argon2": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "tsx": "catalog:"
  }
}
